{
  "manifest_version": 3,
  "name": "Deepmode",
  "version": "2.4.2",
  "description": "Define one task. Lock in focus. See exactly how you spend your time on your current projects — with AI insights that help you improve every week.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Deepmode",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://deepmode.onrender.com/*",
    "https://youtube.com/*",
    "https://*.youtube.com/*",
    "https://x.com/*",
    "https://*.x.com/*",
    "https://twitter.com/*",
    "https://*.twitter.com/*",
    "https://instagram.com/*",
    "https://*.instagram.com/*",
    "https://facebook.com/*",
    "https://*.facebook.com/*",
    "https://reddit.com/*",
    "https://*.reddit.com/*",
    "https://tiktok.com/*",
    "https://*.tiktok.com/*",
    "https://linkedin.com/*",
    "https://*.linkedin.com/*",
    "https://discord.com/*",
    "https://*.discord.com/*",
    "https://web.whatsapp.com/*",
    "https://web.telegram.org/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://deepmode.onrender.com/*"      
      ],
      "js": ["connect.js"],
      "run_at": "document_idle"
    }
  ]
}
