{
  "manifest_version": 3,
  "name": "Deepmode",
  "version": "2.4.0",
  "description": "Define one task. Lock in focus. See exactly how you spend your time on your current projects — with AI insights that help you improve every week.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Deepmode",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*",
	"https://deepmode.app/*"    
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://deepmode.app/*"      
      ],
      "js": ["connect.js"],
      "run_at": "document_idle"
    }
  ]
}
