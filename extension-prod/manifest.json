{
  "manifest_version": 3,
  "name": "Deepmode",
  "version": "2.4.5",
  "description": "Project-based deep work tracker for professionals. Block distractions, define one task, and track where your focused time goes.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Deepmode",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://deepmode.app/*",
    "https://youtube.com/*",
    "https://*.youtube.com/*",
    "https://x.com/*",
    "https://*.x.com/*",
    "https://twitter.com/*",
    "https://*.twitter.com/*",
    "https://instagram.com/*",
    "https://*.instagram.com/*",
    "https://facebook.com/*",
    "https://*.facebook.com/*",
    "https://reddit.com/*",
    "https://*.reddit.com/*",
    "https://tiktok.com/*",
    "https://*.tiktok.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://deepmode.app/*"      
      ],
      "js": ["connect.js"],
      "run_at": "document_idle"
    }
  ]
}
